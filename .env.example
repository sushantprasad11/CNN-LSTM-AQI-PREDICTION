# ============================================================
# AQI Prediction CNN-LSTM — Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
# cp .env.example .env
# ============================================================

# Flask Application Settings
FLASK_APP=app/app.py
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000
HOST=127.0.0.1

# Deep Learning / Backend Configuration
KERAS_BACKEND=tensorflow
KERAS_HOME=.keras
MPLCONFIGDIR=.matplotlib

# Target City & Geolocation (Default: Delhi, India)
CITY_NAME=Delhi
LATITUDE=28.6139
LONGITUDE=77.2090
